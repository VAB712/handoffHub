# PostgreSQL
DATABASE_URL="postgresql://handoff:handoff@localhost:5432/handoff?schema=public"

# NextAuth (generate: openssl rand -base64 32)
AUTH_SECRET="replace-with-random-secret"

# App URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Display timezone for comment prefixes e.g. America/New_York, Asia/Kolkata
HANDOFF_TZ="UTC"

# New attachments are stored in the database and downloaded through the app.
# ATTACHMENTS_DIR is only an extra copy for older files. The browser does not open this folder.
ATTACHMENTS_DIR="./data/attachments"

# Max upload bytes (default 50MB if unset)
MAX_UPLOAD_BYTES=52428800

# Mail the handoff table to each workspace's DL / email.
# SMTP_HOST is required before the Mail button can send. Auth is optional (internal relay).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=25
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="handoff-hub@example.com"

# Seed user team: on_shore | off_shore | none (optional). When set, that user may edit that team's updates.
# SEED_USER_TEAM="on_shore"
#
# The seeded user (SEED_ADMIN_EMAIL) is always workspace admin (can add/rename workspace tabs).
