# Perforce ignore — keep build output, secrets, and local deps out of the depot.
# Set P4IGNORE=.p4ignore in your client spec (or P4IGNORE env var).

# Git (if present locally; do not submit)
.git/
.gitignore

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem
.env
.env.local
.env.*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# runtime uploads (back up separately with the database)
data/attachments/

# typescript / generated
*.tsbuildinfo
next-env.d.ts

# IDE / local editor (optional; safe to exclude)
.cursor/
.vscode/
